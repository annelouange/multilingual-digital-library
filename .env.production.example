# Production environment template for MULTILINGUAL DIGITAL LIBRARY
# Copy to your host secret manager or .env.production. Do not commit real values.

APP_ENV=production
APP_NAME="Multilingual Library"
APP_URL=https://multilingual-library.example.com
APP_ALLOWED_ORIGINS=https://multilingual-library.example.com,https://www.library.example.com
CORS_ALLOW_CREDENTIALS=true
SECURE_HEADERS=true
ENFORCE_HTTPS=true

# Frontend build must point at the public backend URL.
VITE_API_BASE_URL=https://multilingual-library.example.com/backend
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3001
MDL_BACKEND_HEALTH_URL=https://multilingual-library.example.com/backend/health

# MySQL/MariaDB database
DB_HOST=db.example.internal
DB_PORT=3306
DB_NAME=multilingual_digital_library
DB_USER=ines_library_app
DB_PASSWORD=replace-with-a-long-random-password
DB_CHARSET=utf8mb4

# Auth/session policy
TOKEN_TTL_HOURS=8

# File storage. Prefer a persistent disk/volume outside the source tree.

# Storage abstraction. Use local now; later s3/r2/b2/minio via compatible credentials.
STORAGE_DISK=local
STORAGE_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_KEY=
S3_SECRET=
UPLOAD_DIR=/var/www/multilingual-library/uploads
MAX_BOOK_UPLOAD_BYTES=52428800
MAX_LECTURE_NOTE_UPLOAD_BYTES=26214400

# AI microservices. Put these behind private networking or firewall rules.
TRANSFORMER_STT_HEALTH_URL=http://127.0.0.1:5006/health
TRANSFORMER_STT_URL=http://127.0.0.1:5006/api/stt/transcribe
WHISPER_STT_HEALTH_URL=http://127.0.0.1:5001/health
WHISPER_STT_URL=http://127.0.0.1:5001/transcribe
SPEECHT5_TTS_HEALTH_URL=http://127.0.0.1:5007/health
SPEECHT5_TTS_URL=http://127.0.0.1:5007/synthesize

# Operational defaults
LOG_LEVEL=warn
BACKUP_RETENTION_DAYS=14

# Lean AI model stack
MMS_TTS_HEALTH_URL=http://127.0.0.1:5009/health
MMS_TTS_URL=http://127.0.0.1:5009/synthesize
MMS_TTS_EN_MODEL=facebook/mms-tts-eng
MMS_TTS_FR_MODEL=facebook/mms-tts-fra
MMS_TTS_RW_MODEL=facebook/mms-tts-kin
MMS_TTS_SW_MODEL=facebook/mms-tts-swh
MODEL_API_FALLBACK_1_URL=
MODEL_API_FALLBACK_1_KEY=
MODEL_API_FALLBACK_2_URL=
MODEL_API_FALLBACK_2_KEY=
